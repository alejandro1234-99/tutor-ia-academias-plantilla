# ===================================================================
#  PLANTILLA DE SECRETOS  (esta SÍ se sube, porque va vacía)
# ===================================================================
#  Copia este archivo, llámalo ".env.local" y rellena los valores.
#  Sirve para que cualquiera sepa QUÉ claves hacen falta, sin darle
#  las claves de verdad. En Vercel se ponen las mismas, en
#  Settings → Environment Variables.
# ===================================================================

# --- Qué academia es esta copia ------------------------------------
# El nombre de la carpeta dentro de academias/ (por ejemplo: temario-claro).
ACADEMIA=

# La dirección web de la app, sin barra al final. Sale en los enlaces de
# los correos. Ejemplo: https://estudio.suacademia.com
URL_WEB=

# --- Base de datos (Supabase) ---------------------------------------
# Supabase → el proyecto → botón «Connect» → «Transaction pooler».
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=

# --- Inteligencia artificial -----------------------------------------
# console.anthropic.com → API Keys. Imprescindible.
ANTHROPIC_API_KEY=
# voyageai.com → API Keys. Opcional: sin ella, el buscador solo busca por
# palabras (y ya encuentra la página correcta en 46 de 50 dudas típicas).
VOYAGE_API_KEY=

# --- Correo (Resend) ------------------------------------------------
# resend.com → API Keys, con el dominio de la academia ya verificado.
RESEND_API_KEY=
# La dirección desde la que salen los correos. Ejemplo: avisos@suacademia.com
# (el nombre que ve el alumno sale de la configuración). Si se deja vacío,
# se usa el correo de avisos de la configuración.
CORREO_REMITENTE=

# --- Nuestro equipo -------------------------------------------------
# Los correos del equipo técnico (separados por comas). Ven el panel
# técnico y pueden entrar en modo soporte.
CORREOS_TECNICOS=

# Una contraseña larga inventada, para que solo Vercel pueda lanzar los
# correos automáticos de cada mañana. Ejemplo: sale de «openssl rand -hex 32».
CRON_SECRET=

# --- Solo en la copia de pruebas (NUNCA en la de verdad) ------------
# MODO_PRUEBAS=1 → el buzón y el panel de pruebas. Cada correo se copia en
# /pruebas/buzon; a los correos @example.com no se les manda nada.
MODO_PRUEBAS=
# IA_SIMULADA=1 → una IA de prueba que copia el párrafo del temario, para
# trabajar sin gastar. En una web publicada solo funciona si además está
# MODO_PRUEBAS=1.
IA_SIMULADA=
# Para que todos los correos de prueba te lleguen a ti: tucorreo@dominio.com
# (cada persona usa tucorreo+nombre@dominio.com).
CORREO_PRUEBAS_BASE=

# --- Ajustes finos (normalmente se dejan vacíos) ---------------------
# DOLAR_A_EURO=0.9            cambio para enseñar el coste en euros
# MODELO_PRINCIPAL=           modelo de Claude para chat y material
# MODELO_RAPIDO=              modelo de Claude para las tareas pequeñas
# BD_CONEXIONES=              conexiones a la base de datos por servidor
